# LLM Provider Configuration
# Comma-separated list of provider:model pairs
AISUITE_DEFAULT_MODELS="openai:gpt-4o,google:gemini-2.5-flash,ollama:llama3.2"

# Helmholtz Blablador Configuration
BLABLADOR_API_KEY="your-blablador-api-key"
BLABLADOR_API_BASE="https://api.blablador.example.com/v1"

# Provider API Keys
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GOOGLE_API_KEY="your-google-api-key"

# Local Ollama (optional): server URL, preferred model, and chat fallback chain
# OLLAMA_API_URL="http://localhost:11434"
# HELLM_OLLAMA_MODEL="llama3.2:3b"
# HELLM_FALLBACK_MODELS="ollama"

# Optional Configuration
HELMHOLTZ_TIMEOUT_SECONDS=30.0
