#!/usr/bin/env bash
# hellm-setup - Configure hellmholtz CLI with persistent user-level settings
# Usage: hellm-setup --api-key KEY --base-url URL

set -e

CONFIG_DIR="$HOME/.config/hellmholtz"
CONFIG_FILE="$CONFIG_DIR/.env"

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# Parse arguments
API_KEY=""
BASE_URL=""
DEFAULT_MODELS=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --api-key)
            API_KEY="$2"
            shift 2
            ;;
        --base-url)
            BASE_URL="$2"
            shift 2
            ;;
        --default-models)
            DEFAULT_MODELS="$2"
            shift 2
            ;;
        --show)
            if [[ -f "$CONFIG_FILE" ]]; then
                echo "Current hellmholtz configuration ($CONFIG_FILE):"
                echo "---"
                cat "$CONFIG_FILE"
                echo "---"
            else
                echo "No configuration found at $CONFIG_FILE"
            fi
            exit 0
            ;;
        --help)
            echo "Usage: hellm-setup [options]"
            echo ""
            echo "Configure hellmholtz CLI with persistent user-level settings"
            echo ""
            echo "Options:"
            echo "  --api-key <key>        Set Blablador API key"
            echo "  --base-url <url>       Set Blablador Base URL"
            echo "  --default-models <list> Set default models (comma-separated)"
            echo "  --show                 Show current configuration"
            echo "  --help                 Show this help message"
            echo ""
            echo "Examples:"
            echo "  hellm-setup --api-key 'sk-123...' --base-url 'https://api.blablador.com/v1'"
            echo "  hellm-setup --default-models 'meta-llama/Meta-Llama-3.1-8B-Instruct,gpt-4'"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Create .env file
{
    echo "# Helmholtz Blablador Configuration (user-level)"
    echo "# Generated by hellm-setup on $(date)"
    echo ""
} > "$CONFIG_FILE"

if [[ -n "$API_KEY" ]]; then
    echo "BLABLADOR_API_KEY=\"$API_KEY\"" >> "$CONFIG_FILE"
    echo "✓ API key configured"
fi

if [[ -n "$BASE_URL" ]]; then
    echo "BLABLADOR_API_BASE=\"$BASE_URL\"" >> "$CONFIG_FILE"
    echo "✓ Base URL configured"
fi

if [[ -n "$DEFAULT_MODELS" ]]; then
    echo "AISUITE_DEFAULT_MODELS=\"$DEFAULT_MODELS\"" >> "$CONFIG_FILE"
    echo "✓ Default models configured"
fi

# Add optional timeout (default)
echo "HELMHOLTZ_TIMEOUT_SECONDS=30.0" >> "$CONFIG_FILE"

echo ""
echo "Configuration saved to: $CONFIG_FILE"
echo ""
echo "The configuration is now persistent across all projects!"
echo ""
echo "Run 'hellm-setup --show' to view your configuration."
echo "Run 'hellm models' to verify it's working."
