#!/usr/bin/env bash
# hellm-setup - Configure hellmholtz CLI with persistent user-level settings
# Usage: hellm-setup --api-key KEY --base-url URL

set -e

CONFIG_DIR="$HOME/.config/hellmholtz"
CONFIG_FILE="$CONFIG_DIR/.env"

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# Parse arguments
API_KEY=""
BASE_URL=""
DEFAULT_MODELS=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --api-key)
            API_KEY="$2"
            shift 2
            ;;
        --base-url)
            BASE_URL="$2"
            shift 2
            ;;
        --default-models)
            DEFAULT_MODELS="$2"
            shift 2
            ;;
        --show)
            if [[ -f "$CONFIG_FILE" ]]; then
                echo "Current hellmholtz configuration ($CONFIG_FILE):"
                echo "---"
                cat "$CONFIG_FILE"
                echo "---"
            else
                echo "No configuration found at $CONFIG_FILE"
            fi
            exit 0
            ;;
        --help)
            echo "Usage: hellm-setup [options]"
            echo ""
            echo "Configure hellmholtz CLI with persistent user-level settings"
            echo ""
            echo "Options:"
            echo "  --api-key <key>        Set Blablador API key"
            echo "  --base-url <url>       Set Blablador Base URL"
            echo "  --default-models <list> Set default models (comma-separated)"
            echo "  --show                 Show current configuration"
            echo "  --help                 Show this help message"
            echo ""
            echo "Examples:"
            echo "  hellm-setup --api-key 'sk-123...' --base-url 'https://api.blablador.com/v1'"
            echo "  hellm-setup --default-models 'meta-llama/Meta-Llama-3.1-8B-Instruct,gpt-4'"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Helper function to extract a value from existing config
get_config_value() {
    local key="$1"
    if [[ -f "$CONFIG_FILE" ]]; then
        grep -E "^${key}=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2- | sed 's/^"//;s/"$//'
    fi
}

# Create temp file for atomic write
TEMP_FILE=$(mktemp)

# Generate header
{
    echo "# Helmholtz Blablador Configuration (user-level)"
    echo "# Generated by hellm-setup on $(date)"
    echo ""
} > "$TEMP_FILE"

# Helper to write config key (preserve existing if not overridden)
write_config_key() {
    local key="$1"
    local new_value="$2"
    local default_value="$3"

    if [[ -n "$new_value" ]]; then
        echo "${key}=\"${new_value}\"" >> "$TEMP_FILE"
    else
        # Get existing value or use default
        local existing=$(get_config_value "$key")
        if [[ -n "$existing" ]]; then
            echo "${key}=\"${existing}\"" >> "$TEMP_FILE"
        else
            echo "# ${key}=\"${default_value}\"" >> "$TEMP_FILE"
        fi
    fi
}

# Write keys in order, preserving existing values
write_config_key "BLABLADOR_API_KEY" "$API_KEY" "your-api-key-here"
write_config_key "BLABLADOR_API_BASE" "$BASE_URL" "https://api.blablador.example.com/v1"
write_config_key "AISUITE_DEFAULT_MODELS" "$DEFAULT_MODELS" "meta-llama/Meta-Llama-3.1-8B-Instruct"
write_config_key "HELMHOLTZ_TIMEOUT_SECONDS" "" "30.0"

# Atomic write: replace old config with new
mv "$TEMP_FILE" "$CONFIG_FILE"

# Report configured keys
[[ -n "$API_KEY" ]] && echo "✓ API key configured"
[[ -n "$BASE_URL" ]] && echo "✓ Base URL configured"
[[ -n "$DEFAULT_MODELS" ]] && echo "✓ Default models configured"

echo ""
echo "Configuration saved to: $CONFIG_FILE"
echo ""
echo "The configuration is now persistent across all projects!"
echo ""
echo "Run 'hellm-setup --show' to view your configuration."
echo "Run 'hellm models' to verify it's working."
