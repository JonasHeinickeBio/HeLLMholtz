#!/usr/bin/env bash
# hellm-config - Configure hellmholtz CLI for user-level persistence
# Usage: hellm-config --set-api-key <key> --set-base-url <url>

set -e

CONFIG_DIR="$HOME/.config/hellmholtz"
CONFIG_FILE="$CONFIG_DIR/.env"

# Ensure config directory exists
mkdir -p "$CONFIG_DIR"

# Parse arguments
API_KEY=""
BASE_URL=""
DEFAULT_MODELS=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --set-api-key)
            API_KEY="$2"
            shift 2
            ;;
        --set-base-url)
            BASE_URL="$2"
            shift 2
            ;;
        --set-default-models)
            DEFAULT_MODELS="$2"
            shift 2
            ;;
        --help)
            echo "Usage: hellm-config [options]"
            echo ""
            echo "Configure hellmholtz CLI with persistent settings"
            echo ""
            echo "Options:"
            echo "  --set-api-key <key>      Set Blablador API key"
            echo "  --set-base-url <url>     Set Blablador Base URL"
            echo "  --set-default-models <list>  Set default models (comma-separated)"
            echo "  --show                   Show current configuration"
            echo "  --help                   Show this help message"
            exit 0
            ;;
        --show)
            if [[ -f "$CONFIG_FILE" ]]; then
                echo "Current hellmholtz configuration ($CONFIG_FILE):"
                cat "$CONFIG_FILE"
            else
                echo "No configuration found at $CONFIG_FILE"
            fi
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Helper function to update a key in the config file
# Usage: update_config_key "KEY_NAME" "value" "commented_default"
update_config_key() {
    local key_name="$1"
    local new_value="$2"
    local default_value="$3"

    if [[ -n "$new_value" ]]; then
        # Key provided via CLI - update or add
        if grep -q "^${key_name}=" "$CONFIG_FILE" 2>/dev/null; then
            # Replace existing line
            sed -i "s|^${key_name}=.*|${key_name}=\"${new_value}\"|" "$CONFIG_FILE"
        else
            # Add new line
            echo "${key_name}=\"${new_value}\"" >> "$CONFIG_FILE"
        fi
        return 0
    else
        # No key provided - check if key exists, if not add commented default
        if ! grep -q "^${key_name}=" "$CONFIG_FILE" 2>/dev/null; then
            echo "# ${key_name}=\"${default_value}\"" >> "$CONFIG_FILE"
        fi
        return 1
    fi
}

# Load or create CONFIG_FILE if missing
if [[ ! -f "$CONFIG_FILE" ]]; then
    {
        echo "# Helmholtz Blablador Configuration (managed by hellm-config)"
        echo "# Last updated: $(date)"
        echo ""
    } > "$CONFIG_FILE"
fi

# Update keys - preserve existing values and only update passed arguments
UPDATED=0

update_config_key "BLABLADOR_API_KEY" "$API_KEY" "your-api-key-here" && UPDATED=1
if [[ $UPDATED -eq 0 && -z "$API_KEY" ]]; then
    echo "⚠ API key not set (edit $CONFIG_FILE to add)"
fi || echo "✓ API key configured"

UPDATED=0
update_config_key "BLABLADOR_API_BASE" "$BASE_URL" "https://api.blablador.example.com/v1" && UPDATED=1
if [[ $UPDATED -eq 0 && -z "$BASE_URL" ]]; then
    echo "⚠ Base URL not set (edit $CONFIG_FILE to add)"
fi || echo "✓ Base URL configured"

UPDATED=0
update_config_key "AISUITE_DEFAULT_MODELS" "$DEFAULT_MODELS" "meta-llama/Meta-Llama-3.1-8B-Instruct" && UPDATED=1
if [[ $UPDATED -eq 0 && -z "$DEFAULT_MODELS" ]]; then
    echo "⚠ Default models not set (edit $CONFIG_FILE to add)"
fi || echo "✓ Default models configured"

echo ""
echo "Configuration saved to: $CONFIG_FILE"
echo ""
echo "To use this configuration, add the following to your ~/.bashrc or ~/.zshrc:"
echo ""
echo "  # Load hellmholtz configuration"
echo "  export DOTENV_FILE=\"$CONFIG_FILE\""
echo "  export BLABLADOR_API_KEY=\"\$(grep BLABLADOR_API_KEY $CONFIG_FILE | cut -d'\"' -f2)\""
echo "  export BLABLADOR_API_BASE=\"\$(grep BLABLADOR_API_BASE $CONFIG_FILE | cut -d'\"' -f2)\""
echo ""
echo "Or simply source the config file before running hellm:"
echo "  source $CONFIG_FILE"
echo "  hellm models"
